# Run ./scripts/init-prod-env.sh on the server to create a private .env.prod.
# Review domain/email values and configure optional integrations before starting.
# Never copy your local .env, frontend/.env.local or local database to production.
SITE_HOST=www.opektra.com
SITE_APEX=opektra.com
TLS_EMAIL=admin@opektra.com

# Use a different `openssl rand -hex 32` result for EACH secret.
# Hex avoids URL-escaping and Compose interpolation issues in DATABASE_URL.
POSTGRES_PASSWORD=
SECRET_KEY=
ADMIN_EMAIL=admin@opektra.com
ADMIN_PASSWORD=

# Public values are compiled into Next.js; changing them requires a rebuild.
NEXT_PUBLIC_NOINDEX=false

# Optional server-only integrations. Leave empty when unused.
GITHUB_USERNAME=
GITHUB_TOKEN=
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL=
