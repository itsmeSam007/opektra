# FounderOS — Monorepo Environment
# Copy to .env and adjust. Port defaults: see PORTS.md

# --- Port overrides (host machine) ---
FOS_PORT_FRONTEND=13000
FOS_PORT_API=18000
FOS_PORT_POSTGRES=15432
FOS_PORT_REDIS=16379

# --- Shared ---
APP_ENV=development

# --- Backend (FastAPI) — use host ports when connecting from your machine ---
DATABASE_URL=postgresql://portfolio:portfolio@localhost:15432/portfolio
REDIS_URL=redis://localhost:16379/0
SECRET_KEY=dev-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:13000
MEDIA_ROOT=./data/media
TENANT_ID=default
ADMIN_EMAIL=admin@founderos.local
ADMIN_PASSWORD=admin123
GITHUB_USERNAME=
GITHUB_TOKEN=
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:18000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:13000
NEXT_PUBLIC_ANALYTICS_ID=
