APP_ENV=development
# Docker internal hostnames (used inside compose network)
DATABASE_URL=postgresql://portfolio:portfolio@db:5432/portfolio
REDIS_URL=redis://redis:6379/0
SECRET_KEY=dev-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Browser origin when frontend is on host port 13000
CORS_ORIGINS=http://localhost:13000,http://frontend:3000
MEDIA_ROOT=/data/media
TENANT_ID=default
ADMIN_EMAIL=admin@founderos.local
ADMIN_PASSWORD=admin123
GITHUB_USERNAME=
GITHUB_TOKEN=
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# Local dev on host (db/redis via docker compose ports) — uncomment:
# DATABASE_URL=postgresql://portfolio:portfolio@localhost:15432/portfolio
# REDIS_URL=redis://localhost:16379/0
